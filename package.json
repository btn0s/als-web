{
  "name": "als-ue5-r3f",
  "private": true,
  "version": "0.0.0",
  "description": "A standalone web port of ALS Refactored on React Three Fiber.",
  "keywords": [
    "advanced-locomotion-system",
    "als-refactored",
    "react-three-fiber",
    "three.js",
    "rapier"
  ],
  "type": "module",
  "exports": {
    "./app/Character": "./src/app/Character.tsx",
    "./app/AlsCamera": "./src/app/AlsCamera.tsx",
    "./app/CharacterPoseSample": "./src/app/CharacterPoseSample.ts",
    "./als/ALSExtras/Core/B_Als_PlayerController": "./src/als/ALSExtras/Core/B_Als_PlayerController.tsx",
    "./als/ALSExtras/UI/W_Als_OverlayModeMenu": "./src/als/ALSExtras/UI/W_Als_OverlayModeMenu.tsx",
    "./als/AlsCharacter.hooks": "./src/als/AlsCharacter.hooks.ts",
    "./engine/alsFramePipeline": "./src/engine/alsFramePipeline.ts",
    "./engine/alsAudioBridge": "./src/engine/alsAudioBridge.ts",
    "./engine/timeDilation": "./src/engine/timeDilation.ts",
    "./app/AlsRemoteActor": "./src/app/AlsRemoteActor.tsx",
    "./als/AlsCharacterSnapshot": "./src/als/AlsCharacterSnapshot.ts",
    "./als/AlsSnapshotBuffer": "./src/als/AlsSnapshotBuffer.ts",
    "./als/AlsCharacterRecorder": "./src/als/AlsCharacterRecorder.ts",
    "./app/AlsCharacterGltf": "./src/app/AlsCharacterGltf.ts",
    "./app/AlsCharacterGltf.hooks": "./src/app/AlsCharacterGltf.hooks.ts",
    "./engine/gltfAnimationExtras": "./src/engine/gltfAnimationExtras.ts",
    "./als/AnimGraph/consumerOverlayStates": "./src/als/AnimGraph/consumerOverlayStates.ts"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "diagnose:animation": "node scripts/animation-pose-delta.mjs",
    "test": "vitest run",
    "check": "pnpm test && pnpm build",
    "check:e2e": "playwright test",
    "e2e": "playwright test",
    "lint": "oxlint",
    "process-hygiene:agent-browser": "node scripts/agent-browser-process-hygiene.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "leva": "^0.10.1",
    "postprocessing": "6.39.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
